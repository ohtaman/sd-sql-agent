# LLM（必須）
GEMINI_API_KEY=<your_api_key>

# モデル（任意。未設定時は gemini-2.5-pro）
# LLM_MODEL=gemini-2.5-pro

# Database（任意。未設定時は bird）
SQL_AGENT_DB_TYPE=bird

# パス（相対なら project_root 基準、絶対パスならそのまま。未設定時は config のデフォルト）
# SQL_AGENT_DUCKDB_PATH=duckdb/workspace.duckdb
# SQL_AGENT_BIRD_PATH=data/bird/minidev/MINIDEV
# SQL_AGENT_KNOWLEDGES_DUCKDB_PATH=duckdb/knowledges.duckdb
# SQL_AGENT_KNOWLEDGES_SCHEMA=knowledges
